# Virtual Environment
.venv/
venv/
env/
ENV/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Browser User Data / Session (Jangan di-commit karena berisi cookie & login pribadi)
user_browser_data/
*.session

# Attachments / Personal CVs (Mencegah data pribadi ter-commit ke publik)
attachments/*
!attachments/.gitkeep

# Local User Data, History & Backups
data/history.json
data/*.db
data/*.db-*
data/.*.key
data/.*.seal
data/.*.snapshot
data/.legacy_hashes.json
data/*.csv
data/backup_*.json
*.log

# Environment variables
.env
.env.local

# OS files
.DS_Store
Thumbs.db
